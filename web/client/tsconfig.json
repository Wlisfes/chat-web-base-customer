{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "allowSyntheticDefaultImports": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "isolatedModules": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "lib": ["ESNext", "DOM"],
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./*"],
            "@webpack/*": ["../webpack/*"]
        }
    },
    "include": ["./**/*.ts", "./**/*.tsx", "./**/*.vue", "./**/*.d.ts", "../webpack/**/*.ts", "../webpack/**/*.d.ts", "../../env.d.ts"]
}
