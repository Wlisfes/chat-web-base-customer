{
    "name": "chat-web-base-customer",
    "version": "0.1.0",
    "private": true,
    "description": "客户门户 SSR。NestJS 只负责 Vue3 服务端渲染。",
    "license": "UNLICENSED",
    "scripts": {
        "install": "yarn install --ignore-scripts --ignore-engines",
        "dev": "cross-env NODE_ENV=development nest start --watch web-client-ssr-server",
        "build:web": "yarn build:web:client && yarn build:web:server",
        "build:web:client": "vite --config web/vite.config.mts build --ssrManifest --outDir ../build/web-client/client",
        "build:web:server": "vite --config web/vite.config.mts build --ssr entry-server.ts --outDir ../build/web-client/server",
        "build:ssr": "cross-env NODE_ENV=production nest build web-client-ssr-server",
        "build": "yarn build:web && yarn build:ssr",
        "start": "cross-env NODE_ENV=production node dist/apps/web-client-ssr-server/main.js",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@css-render/vue3-ssr": "^0.15.14",
        "@nestjs/common": "^10.4.15",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.15",
        "@nestjs/platform-express": "^10.4.15",
        "@unocss/reset": "^66.12.0",
        "aos-observer": "^1.1.0",
        "axios": "1.7.7",
        "class-validator": "^0.15.1",
        "compression": "^1.7.5",
        "cross-env": "^7.0.3",
        "dayjs": "^1.11.23",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "naive-ui": "2.45.3",
        "pinia": "^2.2.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "universal-cookie": "^7.2.2",
        "vue": "3.5.10",
        "vue-i18n": "^9.14.5",
        "vue-router": "4.4.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@types/compression": "^1.7.5",
        "@types/express": "^4.17.21",
        "@types/node": "^22.5.1",
        "@unocss/preset-rem-to-px": "^0.60.4",
        "@vitejs/plugin-vue": "^5.1.2",
        "@vitejs/plugin-vue-jsx": "^4.0.1",
        "prettier": "3.4.2",
        "sass": "1.77.6",
        "ts-loader": "^9.5.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "5.5.3",
        "unocss": "0.60.4",
        "unplugin-vue-components": "^0.27.4",
        "vite": "5.4.1",
        "vite-plugin-compression": "^0.5.1",
        "vite-svg-loader": "^5.1.3",
        "webpack": "^5.97.1"
    }
}
